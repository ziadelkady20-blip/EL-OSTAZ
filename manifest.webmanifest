{
  "id": "/",
  "name": "الأستاذ للطباعة والخدمات",
  "short_name": "الأستاذ",
  "description": "اطلب خدمات الطباعة وتابع طلبك بسهولة من هاتفك.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f9fd",
  "theme_color": "#293991",
  "icons": [
    {
      "src": "/assets/ostaz-apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/ostaz-customer-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/png",
            ".png"
          ]
        }
      ]
    }
  }
}
